NODE_ENV=production
HOST=0.0.0.0
PORT=4000
POSTGRES_USER=token_farmer
POSTGRES_PASSWORD=replace-with-a-random-database-password
POSTGRES_DB=token_farmer
DATABASE_URL=postgresql://token_farmer:replace-with-a-random-database-password@postgres:5432/token_farmer
REDIS_URL=redis://redis:6379/0
CORS_ORIGIN=http://localhost
BETTER_AUTH_SECRET=replace-with-at-least-32-random-bytes
API_KEY_PEPPER=replace-with-an-independent-random-secret
FIELD_ENCRYPTION_KEY=replace-with-an-independent-random-secret
UPSTREAM_MODE=mock
TEAMOROUTER_BASE_URL=https://api.teamorouter.com/v1
TEAMOROUTER_API_KEY=
TEAMOROUTER_RESALE_APPROVED=false
GAME_TIME_SCALE=1
WORKER_HEALTH_PORT=4100
