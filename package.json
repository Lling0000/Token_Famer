{
  "name": "token-farmer",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter './apps/*' --if-present dev",
    "build": "pnpm -r --if-present build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint apps/api/src apps/worker/src apps/web/app apps/web/components apps/web/e2e apps/web/lib modules packages scripts *.ts *.mjs --ext .ts,.tsx,.mjs --max-warnings=0",
    "typecheck": "pnpm -r --if-present typecheck",
    "architecture:check": "depcruise --config dependency-cruiser.cjs apps modules packages",
    "duplication:check": "jscpd --config jscpd.json",
    "todo:check": "node scripts/check-todos.mjs",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:property": "vitest run --config vitest.property.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:contract": "vitest run --config vitest.contract.config.ts",
    "test:e2e": "pnpm --filter @token-farmer/web test:e2e",
    "db:generate": "pnpm --filter @token-farmer/db-runtime db:generate",
    "db:migrate": "pnpm --filter @token-farmer/db-runtime db:migrate",
    "db:migrate:deploy": "pnpm --filter @token-farmer/db-runtime db:migrate:deploy",
    "db:seed": "pnpm --filter @token-farmer/db-runtime db:seed",
    "db:deploy": "pnpm db:migrate:deploy && pnpm db:seed",
    "db:check": "pnpm --filter @token-farmer/db-runtime db:check",
    "compose:up": "docker compose -f infra/docker-compose.dev.yml up -d --build",
    "compose:down": "docker compose -f infra/docker-compose.dev.yml down",
    "docker:build": "docker compose -f infra/docker-compose.prod.yml build",
    "verify": "pnpm format:check && pnpm lint && pnpm architecture:check && pnpm duplication:check && pnpm todo:check && pnpm typecheck && pnpm test:unit && pnpm test:property && pnpm test:integration && pnpm test:contract && pnpm db:check && pnpm build && pnpm test:e2e"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "latest",
    "@eslint/js": "^9.39.2",
    "@playwright/test": "latest",
    "@types/node": "^26.1.1",
    "dependency-cruiser": "latest",
    "eslint": "^9.39.2",
    "eslint-plugin-boundaries": "latest",
    "eslint-plugin-import-x": "latest",
    "eslint-plugin-jsx-a11y": "latest",
    "eslint-plugin-react-hooks": "latest",
    "fast-check": "latest",
    "globals": "latest",
    "jscpd": "latest",
    "prettier": "latest",
    "tsx": "latest",
    "typescript": "^5.9.3",
    "typescript-eslint": "latest",
    "vitest": "^3.2.4"
  }
}
